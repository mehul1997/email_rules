{
    "predicate": "Any",
    "rules": [
        {
            "field": "from",
            "predicate": "contains",
            "value": "notifications@github.com"
        },
        {
            "field": "subject",
            "predicate": "contains",
            "value": "12+ roles"
        },
        {
            "field": "date",
            "predicate": "less_than",
            "value": "2025-06-12"
        }
    ],
    "actions": ["mark_as_read"]
}
